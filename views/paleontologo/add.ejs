<%- include('../cabecalho')%>


    <div>
        <tr><a href="./paleontologo"> ← Voltar </a></tr>
        <h3>Novo Paleontólogo</h3>


        <form method="post">
            <p>Nome</p>
            <input type="text" name="nome" placeholder="Nome do Paleontólogo" required>
            <br>
            <p>Nascimento</p>
            <input type="number" name="nascimento" placeholder="Ano de nascimento" required>
            <br>
            <p>Descoberta</p>
            <input type="text" name="descoberta" placeholder="Espécies, Dinossauros, etc..." required>
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>